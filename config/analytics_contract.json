{
  "schema_version": "1.1.0",
  "semantic_scope": "Supplied Expedia competition sample of logged click/booking interactions",
  "segment_boundaries": {
    "lead_time_days": [0, 7, 30, 90, 180],
    "stay_nights": [1, 3, 7, 14]
  },
  "semantic_date_policy": {
    "maximum_lead_time_days": 730,
    "maximum_stay_nights": 365,
    "rationale": "Conservative semantic safety bounds preserve long-tail travel behavior while isolating parse-valid century-scale and chronologically impossible dates. Raw values remain in the interaction fact and are never silently deleted."
  },
  "support_thresholds": {
    "minimum_interactions": 100,
    "strong_interactions": 1000
  },
  "quality_thresholds": {
    "maximum_quarantine_rate": 0.001,
    "maximum_proxy_multimarket_rate": 0.25
  },
  "published_metric_names": {
    "primary_outcome": "booking_interaction_share",
    "proxy_outcome": "booking_bearing_proxy_context_share",
    "user_outcome": "booking_user_share"
  },
  "prohibited_claims": [
    "search-to-booking conversion",
    "checkout conversion",
    "Expedia-wide conversion",
    "retention",
    "churn",
    "revenue",
    "GMV",
    "causal uplift"
  ],
  "full_dataset_minimums": {
    "train": 30000000,
    "test": 2000000,
    "destinations": 60000
  }
}
